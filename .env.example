# ANTHROPIC_API_KEY: Required for Claude AI paper summarization.
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# UNSPLASH_ACCESS_KEY: Optional. Used for fetching cover images from Unsplash.
# Get your free key from https://unsplash.com/developers
# If not set, picsum.photos placeholder images will be used instead.
UNSPLASH_ACCESS_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
